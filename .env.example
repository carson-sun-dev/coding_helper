# 将此文件复制为 .env，切勿提交包含真实密钥的 .env 文件
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 普通按量 API 填写 Endpoint ID；Coding Plan 按其接入说明填写模型名称
ARK_DEEPSEEK_MODEL=
ARK_GLM_MODEL=
ARK_AUXILIARY_MODEL=

# 可选值：deepseek 或 glm
ARK_DEFAULT_PRIMARY=deepseek

# 按方舟主模型实际窗口填写；不要默认写成 256k
ARK_DEEPSEEK_CONTEXT_WINDOW=128000
ARK_GLM_CONTEXT_WINDOW=128000
CONTEXT_COMPACT_THRESHOLD=0.70
CONTEXT_COMPACT_TARGET=0.40

# Session 预算：达到后结束本轮，不切到豆包
MAX_MODEL_CALLS=40
MAX_TOOL_CALLS=80
# 主模型服务异常时的额外重试次数，之后再切另一主模型
MODEL_RETRY_ATTEMPTS=1
# 连续相同工具调用达到该次数后停止执行
STUCK_REPEAT_LIMIT=3

# 完成门槛：测试/lint 命令为空则跳过该项；前缀为空表示工作区内均可修改
COMPLETION_ENABLED=true
COMPLETION_TEST_COMMAND=
COMPLETION_LINT_COMMAND=
COMPLETION_ALLOWED_PREFIXES=
MAX_REPAIR_ROUNDS=2
# 确定性验收通过后，是否额外让 Reviewer Subagent 审查 diff（多一次主模型调用）。
# 默认关闭；也可对单次运行用 `coding-helper run ... --review` 临时开启
COMPLETION_REVIEW_ENABLED=false

# 可选：启用默认 GitHub MCP 时填写。不要提交真实 token
# GITHUB_PERSONAL_ACCESS_TOKEN=
